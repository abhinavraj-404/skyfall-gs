# --- Skyfall-GS backend configuration -------------------------------------
# Copy to .env and adjust for your machine. All values are optional; the
# defaults match the directory layout of this repository.

# Absolute path to the cloned Skyfall-GS repository.
# SKYFALL_REPO=/abs/path/to/Skyfall-GS

# Where job data and outputs are stored.
# SKYFALL_WORK_DIR=/abs/path/to/backend/workspace

# Prefix used to activate the conda env for every stage command.
# Set to empty if the server already runs inside the skyfall-gs env.
SKYFALL_CMD_PREFIX=conda run -n skyfall-gs

# Allowed frontend origins (comma-separated). Use your Next.js URL in prod.
SKYFALL_CORS_ORIGINS=*

# Skip COLMAP/SatelliteSfM preprocessing (data already in Skyfall-GS format).
SKYFALL_SKIP_PREPROCESS=0

# Run only Stage 1 (faster, lower quality) and skip Stage 2 (IDU).
SKYFALL_SKIP_STAGE2=0

# Port range for train.py instances.
SKYFALL_PORT_START=6210
SKYFALL_PORT_END=6260
